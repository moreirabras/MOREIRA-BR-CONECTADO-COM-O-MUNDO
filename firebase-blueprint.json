{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account and profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Transaction": {
      "title": "Transaction Record",
      "description": "Financial and billing transactions processed via Mercado Pago",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "gateway": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "amount", "status"]
    },
    "TenantProfile": {
      "title": "Tenant Subscriber Profile",
      "description": "Subscriber company and fiscal data for multi-tenant portal",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "subscriptionTier": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "subscriptionTier", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profile documents"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "Transaction" },
      "description": "Financial transaction records"
    },
    "/tenants/{tenantId}": {
      "schema": { "$ref": "TenantProfile" },
      "description": "Tenant subscriber profile data"
    }
  }
}
